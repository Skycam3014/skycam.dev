@charset "ISO-8859-1";
html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, font, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var, b, u, i, center, dl, dt, dd, ol, ul, li, fieldset, form, label, legend, table, caption, tbody, tfoot, thead, tr, th, td { margin: 0; padding: 0; border: 0; outline: 0; }
body {
	min-height: 100%;
	background: #ffffcc;
	margin-top: 0px;
	line-height: 1;
	font-family: "Times New Roman", serif;

}

p {
	margin-bottom:20px;
	text-indent:40px;
	font-size:18px;

}

.title_bar {
	height:2px;
	border-width:0;
	color:#856287;
	background-color:#856287;

}

.page_title {
	margin-left:auto;
    margin-right:auto;
	margin-top:15px;
	margin-bottom:15px;
	text-align:center;
	
}

.page_content {
	margin-left:auto;
    margin-right:auto;
    margin-top:45px;
    width:75%;
    height:100%;
	line-height:1.5;
	

}

a {
	text-decoration: none;
	color: #856287;
	font-size:20px;

	
}
a:link {
    color: #6d0096;
}


a:visited {
    color: #6d0096;
}


a:hover {
    color: #856287;
}


a:active {
    color: #000000;
}
